        <br>by {{ presentation.host }} ({{ presentation.affiliation }})
        <a href="#{{ presentation.code }}Details" role="button" data-bs-target="#{{ presentation.code }}Details" data-bs-toggle="collapse">[details]</a>
        <div id="{{ presentation.code }}Details" class="collapse talk-details">{{ presentation.summary | safe }}</div>
      </li>
    {% endif %}
  {% endfor %}
</ul>

